---
network_diagram:
  metadata:
    generated: "{{ ansible_date_time.iso8601 }}"
    hostname: "{{ inventory_hostname }}"
    diagram_type: "network_topology"
    format: "yaml"
  
  nodes:
    - id: "host"
      label: "{{ inventory_hostname }}"
      type: "host"
      ip: "{{ ansible_default_ipv4.address | default('Unknown') }}"
      interfaces: "{{ ansible_interfaces | list }}"
    
    {% if include_vm_networks | default(true) %}
    - id: "vm_network"
      label: "VM Network"
      type: "network"
      description: "Virtual Machine Network Configuration"
      details: "{{ vm_network_info.stdout | default('No VM network information') }}"
    {% endif %}
    
    {% if include_storage_networks | default(true) %}
    - id: "storage_network"
      label: "Storage Network"
      type: "network"
      description: "Storage Network Configuration"
      details: "{{ storage_network_info.stdout | default('No storage network information') }}"
    {% endif %}
  
  connections:
    - from: "host"
      to: "vm_network"
      type: "bridge"
      when: include_vm_networks | default(true)
    
    - from: "host"
      to: "storage_network"
      type: "bridge"
      when: include_storage_networks | default(true)
  
  network_details:
    configuration: "{{ network_config.stdout | default('Network configuration not available') }}"
    bridge_info: "{{ bridge_info.stdout | default('Bridge information not available') }}"
    vm_networks: "{{ vm_network_info.stdout | default('VM network information not available') if include_vm_networks | default(true) else 'Not included' }}"
    storage_networks: "{{ storage_network_info.stdout | default('Storage network information not available') if include_storage_networks | default(true) else 'Not included' }}"
